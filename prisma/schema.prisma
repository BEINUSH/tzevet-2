generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id                   String   @id @default(cuid())
  name                 String
  allowSelfVoteDefault Boolean  @default(false)
  soundEnabled         Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  rounds   Round[]
  sessions Session[]
}

// Round.type: MOST_LIKELY | WHO_SAID_IT | TRIVIA | HEAD_TO_HEAD | ANONYMOUS_PROMPT | AWARDS
model Round {
  id             String  @id @default(cuid())
  eventId        String
  event          Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type           String
  order          Int
  title          String?
  questionText   String
  timeLimitSec   Int?
  allowSelfVote  Boolean @default(false)
  scoringEnabled Boolean @default(false)
  // Free-form JSON for per-type extras (head-to-head contestant names,
  // who-said-it correct speaker name, award category label, etc).
  config String?

  options          Option[]
  votes            Vote[]
  anonymousAnswers AnonymousAnswer[]
  roundResults     RoundResult[]

  @@index([eventId, order])
}

model Option {
  id        String  @id @default(cuid())
  roundId   String
  round     Round   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  text      String
  isCorrect Boolean @default(false)
  order     Int

  votes Vote[]

  @@index([roundId])
}

// Session.status: LOBBY | IN_ROUND | LEADERBOARD | FINAL_AWARDS | ENDED
// Session.currentRoundPhase: IDLE | VOTING_OPEN | VOTING_CLOSED | REVEALED | DONE
model Session {
  id                String   @id @default(cuid())
  eventId           String
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  joinCode          String   @unique
  hostToken         String
  roundOrderJson    String?
  status               String    @default("LOBBY")
  currentRoundIndex    Int       @default(-1)
  currentRoundPhase    String    @default("IDLE")
  votingOpenedAt       DateTime?
  showLeaderboard      Boolean   @default(false)
  createdAt            DateTime  @default(now())

  participants     Participant[]
  votes            Vote[]
  anonymousAnswers AnonymousAnswer[]
  roundResults     RoundResult[]
}

model Participant {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name        String
  deviceToken String   @unique
  connected   Boolean  @default(true)
  removed     Boolean  @default(false)
  score       Int      @default(0)
  joinedAt    DateTime @default(now())

  votesCast     Vote[]            @relation("VoterParticipant")
  votesReceived Vote[]            @relation("TargetParticipant")
  answers       AnonymousAnswer[]

  @@index([sessionId])
}

model Vote {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roundId   String
  round     Round   @relation(fields: [roundId], references: [id], onDelete: Cascade)

  participantId String
  participant   Participant @relation("VoterParticipant", fields: [participantId], references: [id], onDelete: Cascade)

  targetParticipantId String?
  targetParticipant   Participant? @relation("TargetParticipant", fields: [targetParticipantId], references: [id], onDelete: SetNull)

  optionId String?
  option   Option? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  // "A" | "B" for HEAD_TO_HEAD rounds
  contestantChoice String?

  createdAt DateTime @default(now())

  @@unique([sessionId, roundId, participantId])
  @@index([sessionId, roundId])
}

model AnonymousAnswer {
  id            String   @id @default(cuid())
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roundId       String
  round         Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  text          String
  hidden        Boolean   @default(false)
  shownAt       DateTime?
  createdAt     DateTime  @default(now())

  @@unique([sessionId, roundId, participantId])
  @@index([sessionId, roundId])
}

// Frozen snapshot written at reveal time, so late votes never change an
// already-revealed result and the host can re-open a past reveal safely.
model RoundResult {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roundId    String
  round      Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  resultJson String
  revealedAt DateTime @default(now())

  @@unique([sessionId, roundId])
}
