generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id                   String    @id @default(cuid())
  name                 String
  allowSelfVoteDefault Boolean   @default(false)
  soundEnabled         Boolean   @default(true)
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  rounds   Round[]
  sessions Session[]
}

model Round {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type String
  order Int
  title String?
  questionText String
  timeLimitSec Int?
  allowSelfVote Boolean @default(false)
  scoringEnabled Boolean @default(false)
  config String?
  options Option[]
  votes Vote[]
  anonymousAnswers AnonymousAnswer[]
  roundResults RoundResult[]
  @@index([eventId, order])
}

model Option {
  id String @id @default(cuid())
  roundId String
  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  text String
  isCorrect Boolean @default(false)
  order Int
  votes Vote[]
  @@index([roundId])
}

model Session {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  joinCode String @unique
  hostToken String
  roundOrderJson String?
  status String @default("LOBBY")
  currentRoundIndex Int @default(-1)
  currentRoundPhase String @default("IDLE")
  votingOpenedAt DateTime?
  showLeaderboard Boolean @default(false)
  createdAt DateTime @default(now())
  participants Participant[]
  votes Vote[]
  anonymousAnswers AnonymousAnswer[]
  roundResults RoundResult[]
}

model Participant {
  id String @id @default(cuid())
  sessionId String
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name String
  teamNumber Int?
  deviceToken String @unique
  connected Boolean @default(true)
  removed Boolean @default(false)
  score Int @default(0)
  joinedAt DateTime @default(now())
  votesCast Vote[] @relation("VoterParticipant")
  votesReceived Vote[] @relation("TargetParticipant")
  answers AnonymousAnswer[]
  @@index([sessionId])
}

model Vote {
  id String @id @default(cuid())
  sessionId String
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roundId String
  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participantId String
  participant Participant @relation("VoterParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  targetParticipantId String?
  targetParticipant Participant? @relation("TargetParticipant", fields: [targetParticipantId], references: [id], onDelete: SetNull)
  optionId String?
  option Option? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  contestantChoice String?
  createdAt DateTime @default(now())
  @@unique([sessionId, roundId, participantId])
  @@index([sessionId, roundId])
}

model AnonymousAnswer {
  id String @id @default(cuid())
  sessionId String
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roundId String
  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participantId String
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  text String
  hidden Boolean @default(false)
  shownAt DateTime?
  createdAt DateTime @default(now())
  @@unique([sessionId, roundId, participantId])
  @@index([sessionId, roundId])
}

model RoundResult {
  id String @id @default(cuid())
  sessionId String
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roundId String
  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  resultJson String
  revealedAt DateTime @default(now())
  @@unique([sessionId, roundId])
}

model Team {
  id String @id @default(cuid())
  name String @unique
  order Int @default(0)
  createdAt DateTime @default(now())
  submissions QuestionSubmission[]
  members TeamMember[]
}

model TeamMember {
  id String @id @default(cuid())
  teamId String
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name String
  isCommander Boolean @default(false)
  order Int @default(0)
  createdAt DateTime @default(now())
  @@index([teamId])
}

model QuestionSubmission {
  id String @id @default(cuid())
  teamId String
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  questionText String
  answerText String?
  createdAt DateTime @default(now())
  @@index([teamId])
}

model CompanyPoll {
  id String @id @default(cuid())
  questionText String
  optionsJson String
  createdByTeam String?
  createdAt DateTime @default(now())
}
